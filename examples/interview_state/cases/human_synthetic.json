  "utterances": [
    {
      "id": "h1",
      "speaker": "stakeholder",
      "text": "I receive a request in the shared inbox."
    },
    {
      "id": "h2",
      "speaker": "stakeholder",
      "text": "Then I copy the customer details into our tracker, which creates a request record."
    },
    {
      "id": "h3",
      "speaker": "stakeholder",
      "text": "If the request is urgent, I call the on-call engineer; otherwise I schedule a normal review."
    },
    {
      "id": "h4",
      "speaker": "stakeholder",
      "text": "During review I update the tracker with the decision."
    },
    {
      "id": "h5",
      "speaker": "stakeholder",
      "text": "Sorry, correction: I only read the tracker during review. The coordinator updates it after review."
    },
    {
      "id": "h6",
      "speaker": "stakeholder",
      "text": "The coordinator updates the tracker after the review."
    },
    {
      "id": "h7",
      "speaker": "stakeholder",
      "text": "We do not know whether the customer has approved the request, so the approval status remains blank."
    },
    {
      "id": "h8",
      "speaker": "stakeholder",
      "text": "The call to the engineer is manual; there is no separate system."
    },
    {
      "id": "h9",
      "speaker": "interviewer",
      "text": "Thank you. I will mark the remaining approval question for follow-up."
    }
